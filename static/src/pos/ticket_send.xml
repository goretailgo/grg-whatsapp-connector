<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="grg_whatsapp_connector.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//button[contains(@t-on-click, 'doPrint.call')]" position="after">
            <button class="control-button btn btn-lg lh-lg flex-grow-1 flex-shrink-1 text-white"
                    style="background: #25D366;"
                    t-att-disabled="grgWaT.busy"
                    t-on-click="() => this.grgWaSendPast(_selectedSyncedOrder)">
                <i t-attf-class="fa {{grgWaT.busy ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-whatsapp'}} me-1"/>WhatsApp
            </button>
        </xpath>
    </t>

    <t t-name="grg_whatsapp_connector.NumberDialog">
        <Dialog title="'Send Receipt on WhatsApp'" size="'md'">
            <div t-if="props.reference" class="text-muted mb-3">
                Receipt: <strong t-esc="props.reference"/>
            </div>
            <label class="form-label fw-bold">Customer WhatsApp number</label>
            <div class="input-group input-group-lg">
                <span class="input-group-text">+91</span>
                <input t-ref="input" type="text" inputmode="numeric" maxlength="10" autocomplete="off"
                       t-att-class="'form-control' + (state.error ? ' is-invalid' : '')"
                       placeholder="10-digit mobile number"
                       t-att-value="state.number"
                       t-on-input="onInput"
                       t-on-keydown="onKeydown"/>
            </div>
            <div class="d-flex justify-content-between mt-2">
                <small t-if="state.error" class="text-danger" t-esc="state.error"/>
                <small t-else="" class="text-muted">Mobile number starting with 6-9</small>
                <small class="text-muted"><t t-esc="state.number.length"/>/10</small>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-lg text-white px-4" style="background: #25D366;" t-on-click="confirm">
                    <i class="fa fa-whatsapp me-1"/>Send
                </button>
                <button class="btn btn-lg btn-secondary" t-on-click="() => this.props.close()">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
