<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grg_wa_log_list" model="ir.ui.view">
        <field name="name">grg.wa.log.list</field>
        <field name="model">grg.wa.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'" decoration-success="state == 'sent'" create="0">
                <field name="create_date"/>
                <field name="reference"/>
                <field name="doc_type"/>
                <field name="partner_id"/>
                <field name="number"/>
                <field name="mode"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'" decoration-danger="state == 'failed'"/>
                <field name="user_id"/>
                <field name="error" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_grg_wa_log_form" model="ir.ui.view">
        <field name="name">grg.wa.log.form</field>
        <field name="model">grg.wa.log</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_resend" type="object" string="Resend on WhatsApp" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="doc_type"/>
                            <field name="pos_order_id"/>
                            <field name="move_id" invisible="not move_id"/>
                            <field name="partner_id"/>
                            <field name="number"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="mode"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="caption"/>
                        <field name="error" invisible="not error"/>
                    </group>
                    <field name="image" widget="image" invisible="not image" options="{'size': [300, 0]}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_grg_wa_log_search" model="ir.ui.view">
        <field name="name">grg.wa.log.search</field>
        <field name="model">grg.wa.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="number"/>
                <field name="partner_id"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Sent By" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_grg_wa_log" model="ir.actions.act_window">
        <field name="name">WhatsApp Log</field>
        <field name="res_model">grg.wa.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_grg_wa_log" name="WhatsApp Log" parent="point_of_sale.menu_point_root"
              action="action_grg_wa_log" sequence="90"/>

    <record id="view_pos_order_form_grg_wa" model="ir.ui.view">
        <field name="name">pos.order.form.grg.wa</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="WhatsApp" name="grg_whatsapp">
                    <field name="grg_wa_log_ids" readonly="1">
                        <list decoration-danger="state == 'failed'">
                            <field name="create_date"/>
                            <field name="number"/>
                            <field name="mode"/>
                            <field name="state"/>
                            <field name="user_id"/>
                            <field name="error"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
